{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "site.schema.json",
  "title": "Site settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "url", "description", "socialDescription", "sourceUrl", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "title": { "type": "string", "minLength": 1, "description": "Browser tab and link-preview title." },
    "url": { "type": "string", "format": "uri", "pattern": "/$", "description": "Canonical site URL, ending in a slash." },
    "description": { "type": "string", "minLength": 1, "description": "Search-engine description." },
    "socialDescription": { "type": "string", "minLength": 1, "description": "Description shown in LinkedIn/Slack link previews." },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "description": "Page sections in display order. Set enabled to false to hide one.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "enabled", "nav"],
        "properties": {
          "id": { "enum": ["hero", "about", "experience", "skills", "projects", "education", "contact"] },
          "label": { "type": "string", "minLength": 1, "description": "Nav link text, and the section heading unless heading is set." },
          "heading": { "type": "string", "minLength": 1, "description": "Optional section heading when it should differ from the nav label." },
          "enabled": { "type": "boolean" },
          "nav": { "type": "boolean", "description": "Show a link to this section in the header nav." }
        }
      }
    }
  }
}
