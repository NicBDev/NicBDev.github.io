{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "jobTitle", "company", "lead", "location", "educationSummary", "links", "about", "contact"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "jobTitle": { "type": "string", "minLength": 1 },
    "company": { "type": "string", "minLength": 1 },
    "lead": { "type": "string", "minLength": 1, "description": "One- or two-sentence summary under your name." },
    "location": { "type": "string", "minLength": 1 },
    "educationSummary": { "type": "string", "minLength": 1 },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Defined once; reused by the hero buttons, contact section and structured data.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "url", "icon", "primary"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "icon": { "enum": ["linkedin", "github", "document", "none"] },
          "primary": { "type": "boolean", "description": "Render as the filled, highlighted button." }
        }
      }
    },
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs", "facts"],
      "properties": {
        "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "text", "links"],
      "properties": {
        "heading": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["linkId", "label"],
            "properties": {
              "linkId": { "type": "string", "description": "Must match the id of an entry in links." },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
