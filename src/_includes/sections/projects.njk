{#- Heading levels shift with headingLevel (2 on the home page, 1 on a section's own page). #}
{%- set h = headingLevel or 2 %}
  <section id="{{ section.id }}" class="section{% if section.alt %} alt{% endif %}">
    <div class="wrap">
      <h{{ h }} class="section-title">{{ section.heading or section.label }}</h{{ h }}>
      <div class="projects-grid">
        {%- for project in projects.projects %}
        <a class="project-card" href="{{ project.url }}" target="_blank" rel="noopener">
          <h{{ h + 1 }} class="project-title">{{ project.name }}</h{{ h + 1 }}>
          <p>{{ project.description }}</p>
          {%- if project.tags.length %}
          <ul class="tags small">{% for tag in project.tags %}<li>{{ tag }}</li>{% endfor %}</ul>
          {%- endif %}
          <span class="card-link">View repository <span aria-hidden="true">→</span></span>
        </a>
        {%- endfor %}
      </div>
      <p class="more-projects">More on <a href="{{ projects.more.url }}" target="_blank" rel="noopener">{{ projects.more.label }}</a></p>
    </div>
  </section>
