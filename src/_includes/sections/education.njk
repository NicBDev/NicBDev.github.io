{#- Heading levels shift with headingLevel (2 on the home page, 1 on a section's own page). #}
{%- set h = headingLevel or 2 %}
  <section id="{{ section.id }}" class="section{% if section.alt %} alt{% endif %}">
    <div class="wrap">
      <h{{ h }} class="section-title">{{ section.heading or section.label }}</h{{ h }}>
      <div class="edu-grid">
        {%- for degree in education.degrees %}
        <article class="card">
          <h{{ h + 1 }} class="card-title">{{ degree.name }}</h{{ h + 1 }}>
          <p class="card-meta">{{ degree.school }}, {{ degree.location }} · {{ degree.year }}</p>
          {%- if degree.description %}
          <p>{{ degree.description }}</p>
          {%- endif %}
        </article>
        {%- endfor %}
        {%- if education.certifications.length %}
        <article class="card">
          <h{{ h + 1 }} class="card-title">Certifications</h{{ h + 1 }}>
          <ul class="cert-list">
            {%- for cert in education.certifications | sortByYearDesc %}
            <li><span>{{ cert.name }}</span><span class="cert-meta">{{ cert.issuer }} · {{ cert.year }}</span></li>
            {%- endfor %}
          </ul>
        </article>
        {%- endif %}
      </div>
    </div>
  </section>
