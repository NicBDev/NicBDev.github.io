  <section id="{{ section.id }}" class="section{% if section.alt %} alt{% endif %}">
    <div class="wrap">
      <h2>{{ section.heading or section.label }}</h2>
      <div class="skills-grid">
        {%- for group in skills.groups %}
        <div class="skill-group">
          <h3>{{ group.name }}</h3>
          <ul class="tags">{% for item in group.items %}<li>{{ item }}</li>{% endfor %}</ul>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>
